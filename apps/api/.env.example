# TiDB Serverless → Connect → Prisma. Pastikan ada ?sslaccept=strict di akhir.
DATABASE_URL="mysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/finance?sslaccept=strict"

# Minimal 32 karakter acak. Buat dengan: openssl rand -base64 48
JWT_SECRET=""

# Wajib untuk membuat PIN pertama kali dan reset PIN kalau lupa. Simpan baik-baik.
SETUP_KEY=""

# Opsional: untuk job otomatis update harga emas (POST /gold-price, header x-cron-secret)
CRON_SECRET=""

# Hanya untuk development lokal kalau web tidak lewat proxy /api
# WEB_ORIGIN="http://localhost:3000"
